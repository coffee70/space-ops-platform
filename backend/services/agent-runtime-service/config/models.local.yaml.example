  - id: anthropic-claude-sonnet-4-6
    providerRef: anthropic-main
    providerModelId: claude-sonnet-4-6
    enabled: false
    disabledReason: Anthropic key not configured for this local stack.
    governance:
      allowedModes: [read_only, suggest]
      dataBoundary: external_api
    metadataOverrides:
      recommendedFor: [coding, deep-reasoning]

  - id: anthropic-claude-opus-4-1
    providerRef: anthropic-main
    providerModelId: claude-opus-4-1
    enabled: false
    disabledReason: Anthropic key not configured for this local stack.
    governance:
      allowedModes: [read_only, suggest]
      dataBoundary: external_api
    metadataOverrides:
      recommendedFor: [deep-reasoning]

  - id: baremetal-qwen-coder-32b
    providerRef: local-baremetal
    providerModelId: qwen2.5-coder-32b-instruct
    enabled: false
    disabledReason: Bare-metal inference endpoint is not running in this local stack.
    governance:
      allowedModes: [read_only, suggest, execute]
      dataBoundary: local_airgapped
    metadataOverrides:
      displayName: Local Qwen Coder 32B
      description: Locally hosted OpenAI-compatible coding model for restricted environments.
      contextWindow: 32768
      maxOutputTokens: 8192
      capabilities: [text, tool-use, code]
      costTier: internal
      speedTier: balanced
      reasoningTier: light
      recommendedFor: [local, air-gapped, coding]

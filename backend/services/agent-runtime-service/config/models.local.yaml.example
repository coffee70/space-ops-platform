# Instantiation-specific model registry — copy to `models.local.yaml` (gitignored).
#
#   cp models.local.yaml.example models.local.yaml
#
# If `models.local.yaml` is missing, agent-runtime loads this file as the default.
# API keys belong in environment variables (`OPENAI_API_KEY`, etc.) via `apiKeyEnv`.
# Override path only when needed: AGENT_RUNTIME_MODELS_CONFIG_PATH=/abs/path/registry.yaml
#

version: 1

defaults:
  chatModel: openai-gpt-5-5
  codingModel: openai-gpt-5-5
  fastModel: openai-gpt-5-1-mini
  restrictedModel: baremetal-qwen-coder-32b

metadataResolvers:
  openrouter:
    enabled: true
    baseUrl: https://openrouter.ai/api/v1/models
    apiKeyEnv: OPENROUTER_API_KEY
    cacheTtlSeconds: 21600
    allowUnauthenticated: true

providers:
  openai-main:
    type: openai
    displayName: OpenAI
    apiKeyEnv: OPENAI_API_KEY

  anthropic-main:
    type: anthropic
    displayName: Anthropic
    apiKeyEnv: ANTHROPIC_API_KEY

  local-baremetal:
    type: openai-compatible
    displayName: Local Bare Metal
    baseUrl: http://baremetal-inference.local/v1
    apiKeyEnv: BAREMETAL_MODEL_API_KEY

models:

  - id: openai-gpt-5-1
    providerRef: openai-main
    providerModelId: gpt-5.1
    enabled: true
    defaultFor: []
    governance: { allowedModes: [read_only, suggest, execute], dataBoundary: external_api }
    metadataOverrides: { recommendedFor: ["coding", "deep-reasoning", "demo-safe"] }

  - id: openai-gpt-5-1-mini
    providerRef: openai-main
    providerModelId: gpt-5.1-mini
    enabled: true
    defaultFor: [fast]
    governance: { allowedModes: [read_only, suggest, execute], dataBoundary: external_api }
    metadataOverrides: { recommendedFor: ["fast-chat", "demo-safe"] }

  - id: openai-gpt-5-1-nano
    providerRef: openai-main
    providerModelId: gpt-5.1-nano
    enabled: true
    defaultFor: []
    governance: { allowedModes: [read_only, suggest], dataBoundary: external_api }
    metadataOverrides: { recommendedFor: ["fast-chat"] }

  - id: openai-gpt-5-1-pro
    providerRef: openai-main
    providerModelId: gpt-5.1-pro
    enabled: true
    defaultFor: []
    governance: { allowedModes: [read_only, suggest], dataBoundary: external_api }
    metadataOverrides: { recommendedFor: ["deep-reasoning", "coding"] }

  - id: openai-gpt-5-1-codex
    providerRef: openai-main
    providerModelId: gpt-5.1-codex
    enabled: true
    defaultFor: []
    governance: { allowedModes: [read_only, suggest, execute], dataBoundary: external_api }
    metadataOverrides: { recommendedFor: ["coding", "deep-reasoning", "demo-safe"] }

  - id: openai-gpt-5-1-codex-max
    providerRef: openai-main
    providerModelId: gpt-5.1-codex-max
    enabled: true
    defaultFor: []
    governance: { allowedModes: [read_only, suggest, execute], dataBoundary: external_api }
    metadataOverrides: { recommendedFor: ["coding", "deep-reasoning", "demo-safe"] }

  - id: openai-gpt-5-2
